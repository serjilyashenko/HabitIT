{
  "name": "habitit",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:all && vite build",
    "preview": "vite preview",
    "prettier:check": "prettier --check --ignore-path .gitignore . --loglevel warn",
    "prettier:fix": "prettier --write --ignore-path .gitignore .",
    "eslint:check": "eslint --ext .js,.jsx . --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "check:all": "npm run prettier:check && npm run eslint:check && npm run test",
    "pre-commit-hook": "lint-staged",
    "postinstall": "cp ./git-hooks/pre-commit ./.git/hooks"
  },
  "lint-staged": {
    "**/*.*": [
      "npm run prettier:check",
      "jest --findRelatedTests --passWithNoTests"
    ],
    "**/*.+(js|mjs|ts|jsx|tsx)": [
      "npm run eslint:check"
    ]
  },
  "dependencies": {
    "classnames": "2.5.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "13.4.0",
    "@testing-library/user-event": "14.4.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jest": "29.0.3",
    "jest-environment-jsdom": "29.0.3",
    "lint-staged": "13.0.3",
    "prettier": "2.7.1",
    "vite": "7.2.4",
    "vite-plugin-svgr": "4.5.0"
  }
}
